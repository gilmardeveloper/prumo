<idea-plugin>
    <id>io.prumo.mcp</id>
    <name>Prumo MCP</name>
    <vendor email="gilmarsilva.developer@gmail.com" url="https://github.com/gilmardeveloper">Gilmar Silva</vendor>

    <description><![CDATA[
        <p><b>Prumo MCP</b> turns your IDE into a standardized, isolated and auditable context source
        for MCP-capable AI clients such as Claude, Codex and Gemini.</p>
        <p>Prumo is not an AI. It is a deterministic layer between the IDE, your code, Git,
        documentation, databases, policies and the external AI client. It defines the boundary the
        assistant may work within &mdash; and enforces it.</p>
        <ul>
            <li>Workspaces that isolate repositories, documentation and databases from one another</li>
            <li>Read-only PostgreSQL access with layered protection</li>
            <li>Credentials kept in the IDE password safe, never in files or logs</li>
            <li>Nothing is ever written inside your project repositories</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.mcpServer</depends>
    <depends>Git4Idea</depends>

    <!-- Textos que a propria plataforma resolve (nome de acao, titulo da tool window). -->
    <resource-bundle>messages.PrumoBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Prumo MCP"
                    key="toolwindow.title"
                    anchor="right"
                    factoryClass="io.prumo.mcp.ui.PrumoToolWindowFactory" />

        <!-- Sem 'key' de proposito: o nome exibido vem de getDisplayName(), que obedece a
             preferencia de idioma do Prumo; a chave do resource-bundle obedeceria so a IDE. -->
        <applicationConfigurable id="io.prumo.mcp.settings"
                                 parentId="tools"
                                 instance="io.prumo.mcp.settings.PrumoLanguageConfigurable" />
    </extensions>

    <extensions defaultExtensionNs="com.intellij.mcpServer">
        <mcpToolset implementation="io.prumo.mcp.toolsets.PrumoDiagnosticsToolset" />
        <mcpToolset implementation="io.prumo.mcp.toolsets.WorkspaceToolset" />
        <mcpToolset implementation="io.prumo.mcp.toolsets.RepositoryToolset" />
        <mcpToolset implementation="io.prumo.mcp.toolsets.IdeToolset" />
        <mcpToolset implementation="io.prumo.mcp.toolsets.DatabaseToolset" />
        <mcpToolset implementation="io.prumo.mcp.toolsets.PackToolset" />
        <mcpToolset implementation="io.prumo.mcp.toolsets.PackAuthoringToolset" />
    </extensions>
</idea-plugin>
